# Automatic HTTPS via Let's Encrypt. DOMAIN comes from the .env file
# next to docker-compose.yml — e.g. DOMAIN=yourdomain.com
{$DOMAIN} {
	reverse_proxy portfolio:3000

	# Sensible security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
